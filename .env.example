# Environment Configuration
PROJECT_NAME="AI-Powered Career & Skill Gap Analyzer"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default PostgreSQL URL (or sqlite:///./skill_analyzer.db for zero-config local testing)
DATABASE_URL="sqlite:///./skill_analyzer.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/career_gap_db"

# CORS
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]'

# Upload limits
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS='["pdf","docx"]'
